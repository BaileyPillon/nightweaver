<Window x:Class="Nightweaver.Desktop.GoalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New OneShot" Width="640" Height="608" MinWidth="525" MinHeight="535"
        WindowStartupLocation="CenterOwner" Background="#1D2421" Foreground="#ECF1EB" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Start a OneShot" Foreground="#ECF1EB" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <RadioButton x:Name="RepoMode" Content="Git repository" Foreground="#ECF1EB" IsChecked="True" Margin="0,0,18,0" Checked="ModeChanged"/>
            <RadioButton x:Name="TemplateMode" Content="Plan template" Foreground="#ECF1EB" Checked="ModeChanged"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,8,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click" Padding="12,5" Margin="8,0,0,0"/>
                <TextBox x:Name="SourcePath" AutomationProperties.Name="Selected source" IsReadOnly="True" VerticalContentAlignment="Center" Background="#161D19" Foreground="#ECF1EB" BorderBrush="#59685E" Padding="6"/>
            </DockPanel>
            <TextBlock x:Name="Checks" TextWrapping="Wrap" Foreground="#C4D4BC" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <Label Grid.Row="3" Content="_Project goal" Target="{Binding ElementName=GoalText}" Foreground="#ECF1EB" Padding="0,5"/>
        <TextBox Grid.Row="4" x:Name="GoalText" AcceptsReturn="True" TextWrapping="Wrap" Padding="10" TextChanged="InputsChanged"
                 VerticalScrollBarVisibility="Auto" Background="#161D19" Foreground="#ECF1EB"
                 CaretBrush="#D4EDAD" BorderBrush="#59685E" FontSize="14" AutomationProperties.Name="Project goal"/>
        <StackPanel Grid.Row="5" Margin="0,12,0,0" Orientation="Horizontal">
            <StackPanel Margin="0,0,15,0">
                <Label x:Name="ProviderLabel" Content="Planner and worker" Target="{Binding ElementName=Planner}" Foreground="#ECF1EB" Padding="0,0,0,4"/>
                <ComboBox x:Name="Planner" SelectedIndex="0" Width="142" SelectionChanged="InputsChanged" AutomationProperties.Name="Primary provider">
                    <ComboBoxItem Content="Codex" Tag="codex"/><ComboBoxItem Content="Claude" Tag="claude"/>
                    <ComboBoxItem Content="DeepSeek" Tag="deepseek"/><ComboBoxItem Content="Gemini" Tag="gemini"/>
                </ComboBox>
            </StackPanel>
            <StackPanel x:Name="RescuePanel">
                <Label Content="Repair worker" Target="{Binding ElementName=Rescue}" Foreground="#ECF1EB" Padding="0,0,0,4"/>
                <ComboBox x:Name="Rescue" SelectedIndex="0" Width="142" SelectionChanged="InputsChanged" AutomationProperties.Name="Repair worker">
                    <ComboBoxItem Content="Same worker" Tag=""/><ComboBoxItem Content="Claude" Tag="claude"/>
                    <ComboBoxItem Content="Codex" Tag="codex"/><ComboBoxItem Content="DeepSeek" Tag="deepseek"/><ComboBoxItem Content="Gemini" Tag="gemini"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="6" Margin="0,10,0,0">
            <CheckBox x:Name="GuardRestarts" Foreground="#ECF1EB" Margin="0,0,0,8"
                      Content="Restart a crashed runner up to twice" AutomationProperties.Name="Restart a crashed runner up to twice"/>
            <Label Content="Primary CLI profile directory (optional)" Target="{Binding ElementName=ProfilePath}" Foreground="#ECF1EB" Padding="0,0,0,4"/>
            <TextBox x:Name="ProfilePath" AutomationProperties.Name="Primary CLI profile directory" Padding="6" Background="#161D19" Foreground="#ECF1EB" CaretBrush="#D4EDAD" BorderBrush="#59685E"/>
        </StackPanel>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="12,6" Margin="0,0,8,0"/>
            <Button x:Name="StartButton" Content="Plan and start" IsDefault="True" IsEnabled="False" Click="Start_Click" Padding="14,6" Foreground="#142014" Background="#D4EDAD"/>
        </StackPanel>
    </Grid>
</Window>
