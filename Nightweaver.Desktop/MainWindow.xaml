<Window x:Class="Nightweaver.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nightweaver" Width="1160" Height="800" MinWidth="880" MinHeight="580"
        Background="#161A19" Foreground="#ECF1EB" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Line" Color="#343F3C"/>
        <SolidColorBrush x:Key="Muted" Color="#A9B8B1"/>
        <SolidColorBrush x:Key="Accent" Color="#D4EDAD"/>
        <SolidColorBrush x:Key="Panel" Color="#1D2421"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#ECF1EB"/>
            <Setter Property="Background" Value="#28322D"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#A9C185"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#D4EDAD"/>
                                <Setter TargetName="Face" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#161D19"/>
            <Setter Property="Foreground" Value="#ECF1EB"/>
            <Setter Property="CaretBrush" Value="#D4EDAD"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="25,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="{StaticResource Accent}" CornerRadius="7" Margin="0,0,11,0">
                        <Path Data="M0,24 L0,0 L5,0 L19,17 L19,0 L24,0 L24,24 L19,24 L5,7 L5,24 Z"
                              Fill="#1C2718" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Nightweaver" FontWeight="SemiBold" FontSize="27" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="New OneShot" Click="OneShot_Click"/>
                    <Button Content="Start a plan" Background="{StaticResource Accent}" Foreground="#1B2717"
                            FontWeight="SemiBold" BorderBrush="{StaticResource Accent}" Margin="0" Click="Add_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="295"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#1A211D" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"
                    Padding="23,21,16,18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Runs" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,13"/>
                    <ListBox x:Name="RunList" BorderThickness="0" Background="Transparent" Foreground="#ECF1EB"
                             SelectionChanged="Run_SelectionChanged" AutomationProperties.Name="Runs">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,5"/>
                                <Setter Property="Foreground" Value="#ECF1EB"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Item" Background="Transparent" CornerRadius="6" Padding="11,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Item" Property="Background" Value="#344330"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Item" Property="BorderBrush" Value="#758C6A"/>
                                                    <Setter TargetName="Item" Property="BorderThickness" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Muted}"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="30,23,25,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock x:Name="RunTitle" Text="Runs" FontSize="29" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="RunSummary" Text="Start a plan to see its milestones and verification evidence."
                               Margin="0,8,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="112" FontSize="14"/>
                    <TextBox x:Name="Branch" IsReadOnly="True" Visibility="Collapsed" BorderThickness="0"
                             Padding="0" Margin="0,8,0,0" Background="Transparent" Foreground="{StaticResource Accent}"
                             FontFamily="Consolas" AutomationProperties.Name="Result branch"/>
                </StackPanel>
                <DockPanel Grid.Row="1" Margin="0,21,0,19">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="ReportButton" Content="Open report" Click="Report_Click" IsEnabled="False"/>
                        <Button x:Name="EvidenceButton" Content="Evidence folder" Click="Evidence_Click" IsEnabled="False"/>
                        <Button x:Name="PauseButton" Content="Pause" Click="Pause_Click" IsEnabled="False"/>
                        <Button x:Name="ResumeButton" Content="Resume" Click="Resume_Click" IsEnabled="False" Margin="0"/>
                    </StackPanel>
                    <TextBlock Text="Activity" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox x:Name="Timeline" Background="{StaticResource Panel}" Foreground="#ECF1EB"
                         BorderBrush="{StaticResource Line}" HorizontalContentAlignment="Stretch" Padding="7"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Run activity">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="11,8" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Foreground="{StaticResource Muted}"
                                                   Margin="14,0,0,0" FontSize="12"/>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                               Margin="0,4,0,0" MaxHeight="110"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Guidance for the next attempt" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/>
                        <DockPanel Grid.Row="1">
                            <Button x:Name="FeedbackButton" Content="Save guidance" DockPanel.Dock="Right" Click="Feedback_Click" Margin="10,0,0,0"/>
                            <TextBox x:Name="FeedbackText" MaxLength="12000" MinHeight="38" MaxHeight="100" TextWrapping="Wrap"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Guidance for the next attempt"/>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,9">
            <TextBlock x:Name="Status" Text="Local workspace" Foreground="{StaticResource Muted}" FontSize="12"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
